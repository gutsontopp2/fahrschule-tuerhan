{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | default: 'Fahrschule Türhan – entspannt zum Führerschein in Liechtenstein und der Region Werdenberg. Fahrstunden mit Handschaltung oder Automat online buchen.'
-%}
<title>
  {{- page_title -}}
  {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
</title>
<meta name="description" content="{{ og_description | escape }}">
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="de_CH">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if page_image -%}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- elsif settings.logo != blank -%}
<meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">

{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "DrivingSchool",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "telephone": {{ settings.contact_phone | json }},
  "email": {{ settings.contact_email | json }},
  "slogan": "Mit mir zum Führerschein.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rotengasse 71",
    "postalCode": "9491",
    "addressLocality": "Ruggell",
    "addressCountry": "LI"
  },
  "areaServed": ["Liechtenstein", "Werdenberg", "Buchs SG", "Ruggell", "Schaan"],
  "priceRange": "CHF"{% if settings.social_instagram != blank %},
  "sameAs": [{{ settings.social_instagram | json }}]{% endif %}
}
</script>
{%- endif -%}
