{%- comment -%}
  Buchungs-Kalender als Snippet – bewusst OHNE Section-Schema, damit Shopify
  es zuverlässig rendert (die Section-Variante wurde von Shopifys strenger
  Prüfung als "invalid section type" abgelehnt).
  Aufruf: {% render 'booking' %}
  Die Fahrstunden-Produkte kommen aus der Kollektion mit Handle "fahrstunden".
{%- endcomment -%}
{%- liquid
  assign col = collections['fahrstunden']
  assign points_raw = settings.booking_meeting_points | newline_to_br
  assign points = points_raw | split: '<br />'
-%}
<section class="section" id="buchung">
  <div class="container booking" data-booking>

    <div class="section-head">
      <span class="eyebrow">Online-Buchung</span>
      <h2>Fahrstunde buchen</h2>
      <p>Wähle deine Fahrstunde, einen freien Termin und bezahle sicher online. Dein Termin ist danach fix – ohne Hin und Her.</p>
      <hr class="roadline">
    </div>

    {%- comment -%} Wird per JS eingeblendet, wenn das Backend nicht erreichbar ist {%- endcomment -%}
    <div class="booking__offline" data-booking-offline hidden>
      <b>Die Online-Buchung ist im Moment nicht verfügbar.</b><br>
      Ruf mich gerne direkt an
      {%- if settings.contact_phone != blank %} unter <a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a>{% endif %}
      {%- if settings.contact_whatsapp != blank %} oder <a href="https://wa.me/{{ settings.contact_whatsapp }}" target="_blank" rel="noopener">schreib per WhatsApp</a>{% endif %} –
      wir finden zusammen einen Termin.
    </div>
    <noscript>
      <div class="booking__offline">
        Für die Online-Buchung wird JavaScript benötigt. Alternativ erreichst du mich telefonisch unter
        {{ settings.contact_phone }}.
      </div>
    </noscript>

    {%- if col == blank or col.products.size == 0 -%}
      <div class="booking__offline">
        <b>Die Online-Buchung ist im Moment nicht verfügbar.</b><br>
        Ruf mich gerne direkt an
        {%- if settings.contact_phone != blank %} unter <a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a>{% endif %} –
        wir finden zusammen einen Termin.
      </div>
    {%- else -%}

    <div data-booking-app>
      <ol class="booking-steps" data-step-indicator>
        <li class="is-active"><span>Fahrstunde</span></li>
        <li><span>Datum</span></li>
        <li><span>Uhrzeit</span></li>
        <li><span>Deine Daten</span></li>
      </ol>

      <div class="booking-error" role="alert" data-booking-error></div>

      <div class="booking-panel" data-panel="lesson">
        <h3><span class="l-tile l-tile--sm" aria-hidden="true">1</span> Fahrstundenart wählen</h3>
        <div class="option-grid" data-lesson-grid>
          <p class="booking-loading">Angebot wird geladen …</p>
        </div>
      </div>

      <div class="booking-panel" data-panel="date" hidden>
        <h3><span class="l-tile l-tile--sm" aria-hidden="true">2</span> Termin wählen</h3>
        <div class="calendar">
          <div class="calendar__head">
            <button type="button" class="calendar__nav" data-cal-prev aria-label="Vorheriger Monat">‹</button>
            <span class="calendar__month" data-cal-month aria-live="polite"></span>
            <button type="button" class="calendar__nav" data-cal-next aria-label="Nächster Monat">›</button>
          </div>
          <p class="booking-loading" data-cal-loading hidden>Verfügbarkeiten werden geladen …</p>
          <div class="calendar__grid" data-cal-grid></div>
          <div class="calendar__legend">
            <span><i class="dot-free"></i>Termine frei</span>
            <span><i class="dot-busy"></i>Ausgebucht / gesperrt</span>
          </div>
        </div>

        <div data-timeslots-wrap hidden style="margin-top:26px;">
          <h4 style="margin-bottom:12px;">Freie Zeiten am <span data-timeslots-date></span></h4>
          <div class="timeslots" data-timeslots></div>
          <p class="booking-hint">Alle Zeiten in lokaler Zeit (Europe/Zurich), 24-Stunden-Format.</p>
        </div>
      </div>

      <form class="booking-panel" data-panel="details" data-booking-form hidden novalidate>
        <h3><span class="l-tile l-tile--sm" aria-hidden="true">3</span> Deine Daten</h3>
        <div class="form-grid">
          <div class="form-field">
            <label for="buchung-vorname">Vorname</label>
            <input type="text" id="buchung-vorname" name="firstName" autocomplete="given-name" required>
          </div>
          <div class="form-field">
            <label for="buchung-nachname">Nachname</label>
            <input type="text" id="buchung-nachname" name="lastName" autocomplete="family-name" required>
          </div>
          <div class="form-field">
            <label for="buchung-email">E-Mail (für die Bestätigung)</label>
            <input type="email" id="buchung-email" name="email" autocomplete="email" required>
          </div>
          <div class="form-field">
            <label for="buchung-phone">Handynummer</label>
            <input type="tel" id="buchung-phone" name="phone" autocomplete="tel" placeholder="+41 …" required>
          </div>
          <div class="form-field" data-vehicle-field hidden>
            <label for="buchung-getriebe">Handschaltung oder Automat?</label>
            <select id="buchung-getriebe" name="vehicleType">
              <option value="" selected disabled>Bitte wählen …</option>
              <option value="handschaltung">Handschaltung</option>
              <option value="automat">Automat</option>
            </select>
          </div>
          <div class="form-field">
            <label for="buchung-treffpunkt">Treffpunkt</label>
            <select id="buchung-treffpunkt" name="meetingPoint" required>
              <option value="" selected disabled>Bitte wählen …</option>
              {%- for point in points -%}
                {%- assign p = point | strip -%}
                {%- if p != blank -%}<option value="{{ p | escape }}">{{ p }}</option>{%- endif -%}
              {%- endfor -%}
            </select>
          </div>
          <div class="form-field">
            <label for="buchung-note">Bemerkung (optional)</label>
            <textarea id="buchung-note" name="note" rows="3" placeholder="z. B. Wunschthemen oder Details zum Abholort"></textarea>
          </div>
          <div class="form-field form-field--checkbox">
            <label>
              <input type="checkbox" name="isFirstLesson" value="1">
              Das ist meine erste Fahrstunde
            </label>
          </div>
          <div class="form-field form-field--checkbox">
            <label>
              <input type="checkbox" name="termsAccepted" value="1" required>
              Ich akzeptiere die
              <a href="/pages/agb" target="_blank" rel="noopener">Buchungs- und Stornierungsbedingungen</a>
              und habe die
              <a href="/pages/datenschutz" target="_blank" rel="noopener">Datenschutzerklärung</a>
              gelesen.
            </label>
          </div>
          {%- comment -%} Honeypot gegen Spam-Bots – für Menschen unsichtbar {%- endcomment -%}
          <div class="visually-hidden" aria-hidden="true">
            <label for="buchung-website">Bitte leer lassen</label>
            <input type="text" id="buchung-website" name="website" tabindex="-1" autocomplete="off">
          </div>
        </div>

        <div class="booking-summary" data-summary hidden style="margin-top:22px;">
          <h3 style="font-size:1rem;">Deine Buchung</h3>
          <dl data-summary-rows></dl>
          <div class="booking-summary__total"><span>Total</span><span data-summary-total></span></div>
        </div>

        <div class="reservation-timer" data-reservation-timer>
          {% render 'icon', name: 'clock' %}
          <span>Termin für dich reserviert – bitte Zahlung abschliessen: <b>20:00</b></span>
        </div>

        <button type="submit" class="btn btn--primary btn--block" data-booking-submit disabled>Verbindlich buchen</button>
        <p class="booking-hint">Beim Klick wird dein Termin verbindlich reserviert und du wirst zur sicheren Bezahlung (Shopify-Checkout) weitergeleitet. Wird die Zahlung nicht innert 20 Minuten abgeschlossen, wird der Termin automatisch wieder freigegeben.</p>
      </form>

      <script type="application/json" data-booking-config>
        {
          "backendUrl": {{ settings.booking_backend_url | default: '' | json }},
          "products": [
            {%- for product in col.products -%}
            {
              "id": {{ product.id }},
              "handle": {{ product.handle | json }},
              "variantId": {{ product.selected_or_first_available_variant.id }},
              "title": {{ product.title | json }},
              "description": {{ product.description | strip_html | truncate: 70 | json }},
              "priceFormatted": {{ product.price | money_with_currency | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      </script>
    </div>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'booking.js' | asset_url }}" defer></script>
