{% layout none %}
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} – Bald verfügbar</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --blau: {{ settings.color_primary | default: '#0B5FD0' }};
      --blau-dunkel: {{ settings.color_primary | default: '#0B5FD0' | color_darken: 12 }};
      --blau-hell: {{ settings.color_primary | default: '#0B5FD0' | color_lighten: 44 }};
      --nacht: #101418; --asphalt: #5C636B; --kreide: #F7F7F4; --weiss: #fff;
      --linie: #E4E4DE; --gruen: #1f8a4c; --rot: #c62828;
      --font-body: system-ui, sans-serif; --font-heading: system-ui, sans-serif;
      --radius: 10px; --radius-sm: 6px; --shadow: 0 6px 24px rgba(16,20,24,0.08); --container: 1140px;
    }
    body { display: flex; min-height: 100vh; align-items: center; justify-content: center; }
    .pw-box { max-width: 420px; width: 100%; padding: 32px; text-align: center; }
  </style>
</head>
<body>
  <div class="pw-box">
    <span class="l-tile" style="width:64px;height:64px;font-size:2.1rem;border-radius:14px;margin-bottom:20px;">L</span>
    <h1 style="font-size:1.6rem;">{{ shop.name }}</h1>
    <p style="color:var(--asphalt);">Die neue Website ist bald online. Fahrstunden kannst du in der Zwischenzeit telefonisch buchen: {{ settings.contact_phone }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="form-field" style="text-align:left;">
        <label for="password">Passwort</label>
        <input type="password" name="password" id="password" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block" style="margin-top:12px;">Anmelden</button>
    {% endform %}
  </div>
</body>
</html>
