{% comment %}
  Ergänzung für die Shopify-Bestellbestätigung (E-Mail).

  Einbau: Shopify-Admin → Einstellungen → Benachrichtigungen →
  Kundenbenachrichtigungen → «Bestellbestätigung» → Code bearbeiten.
  Diesen Block direkt nach der Begrüssung / vor der Artikelliste einfügen.

  Er zeigt die Buchungsdetails (Termin, Uhrzeit, Treffpunkt usw.) aus den
  Line-Item-Properties deutlich sichtbar an. Interne Properties, die mit
  «_» beginnen, werden nicht angezeigt.
{% endcomment %}

{% for line in subtotal_line_items %}
  {% assign has_booking = false %}
  {% for p in line.properties %}
    {% assign first_char = p.first | slice: 0 %}
    {% if p.last != blank and first_char != '_' %}{% assign has_booking = true %}{% endif %}
  {% endfor %}
  {% if has_booking %}
    <table style="width:100%;border:1px solid #e4e4de;border-radius:8px;margin:16px 0;border-collapse:separate;padding:12px 16px;background:#f7f7f4;">
      <tr><td colspan="2" style="font-weight:bold;padding-bottom:8px;">Dein Termin – {{ line.title }}</td></tr>
      {% for p in line.properties %}
        {% assign first_char = p.first | slice: 0 %}
        {% if p.last != blank and first_char != '_' %}
          <tr>
            <td style="padding:2px 12px 2px 0;color:#5c636b;white-space:nowrap;">{{ p.first }}</td>
            <td style="padding:2px 0;">{{ p.last }}</td>
          </tr>
        {% endif %}
      {% endfor %}
      <tr><td colspan="2" style="padding-top:10px;font-size:13px;color:#5c636b;">
        Bitte bring deinen gültigen Lernfahrausweis mit.
        Verschieben oder stornieren: über den Link in der separaten Terminbestätigung
        oder telefonisch unter +41 78 921 33 48 (bitte spätestens 24 Stunden vorher).
      </td></tr>
    </table>
  {% endif %}
{% endfor %}
