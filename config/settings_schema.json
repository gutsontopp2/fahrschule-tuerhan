[
  {
    "name": "theme_info",
    "theme_name": "Fahrschule Türhan",
    "theme_version": "1.0.0",
    "theme_author": "zkii",
    "theme_documentation_url": "https://example.com",
    "theme_support_url": "https://example.com"
  },
  {
    "name": "Farben",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primärfarbe (Buttons, Akzente)",
        "default": "#0B5FD0"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Textfarbe",
        "default": "#101418"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Sekundäre Textfarbe",
        "default": "#5C636B"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Hintergrundfarbe",
        "default": "#F7F7F4"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Linien und Rahmen",
        "default": "#E4E4DE"
      }
    ]
  },
  {
    "name": "Typografie",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Überschriften",
        "default": "archivo_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Fliesstext",
        "default": "work_sans_n4"
      }
    ]
  },
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (optional, sonst Textlogo)"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (64 x 64 px)"
      }
    ]
  },
  {
    "name": "Kontaktdaten",
    "settings": [
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Telefonnummer",
        "default": "+41 78 921 33 48"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "E-Mail-Adresse",
        "default": "tuerhandilek@hotmail.com"
      },
      {
        "type": "text",
        "id": "contact_whatsapp",
        "label": "WhatsApp-Nummer (nur Ziffern, mit Ländercode)",
        "default": "41789213348"
      },
      {
        "type": "textarea",
        "id": "contact_address",
        "label": "Adresse",
        "default": "Fahrschule Türhan Anstalt\nRotengasse 71\n9491 Ruggell, Liechtenstein"
      },
      {
        "type": "textarea",
        "id": "opening_hours",
        "label": "Öffnungszeiten (eine Zeile pro Eintrag)",
        "default": "Montag – Freitag: 08:00 – 17:00\nSamstag & Sonntag: geschlossen"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram-Link"
      }
    ]
  },
  {
    "name": "Buchungssystem",
    "settings": [
      {
        "type": "paragraph",
        "content": "Das Buchungssystem benötigt das zugehörige Backend (Custom App). Trage hier die Basis-URL deines Backends ein, z. B. https://buchung.fahrschule-tuerhan.li"
      },
      {
        "type": "text",
        "id": "booking_backend_url",
        "label": "Backend-URL (ohne Slash am Ende)"
      },
      {
        "type": "range",
        "id": "booking_default_duration",
        "label": "Standarddauer einer Fahrstunde (Minuten)",
        "min": 30,
        "max": 120,
        "step": 5,
        "default": 50
      },
      {
        "type": "checkbox",
        "id": "booking_show_instructor",
        "label": "Fahrlehrer-Auswahl anzeigen",
        "default": true
      },
      {
        "type": "textarea",
        "id": "booking_meeting_points",
        "label": "Treffpunkte (eine Zeile pro Treffpunkt)",
        "default": "Bahnhof Buchs SG\nRuggell, Rotengasse 71\nSchaan, Lindaplatz\nNach Vereinbarung"
      },
      {
        "type": "page",
        "id": "booking_page",
        "label": "Buchungsseite (Seite mit Vorlage page.buchung)"
      }
    ]
  }
]