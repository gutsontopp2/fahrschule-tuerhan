{%- comment -%}
  Fahrzeuge-Abschnitt: zeigt die Fahrschulautos mit Getriebe-Label.
  Bilder als freigestellte PNGs im Theme-Editor je Block hochladen.
  Die Karten gleiten beim Reinscrollen sanft herein (siehe .reveal in global.js).
{%- endcomment -%}
<section class="section section--white" id="fahrzeuge">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      <hr class="roadline">
    </div>

    <div class="fleet">
      {%- for block in section.blocks -%}
        <div class="fleet-card reveal" {{ block.shopify_attributes }}>
          <div class="fleet-card__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 900 }}"
                srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w"
                sizes="(min-width: 700px) 460px, 90vw"
                alt="{{ block.settings.name }} – {{ block.settings.type }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy">
            {%- else -%}
              <div class="fleet-card__placeholder">
                <span class="l-tile" aria-hidden="true">{% render 'icon', name: 'car' %}</span>
                {%- if request.design_mode -%}<small>Bild im Theme-Editor hochladen</small>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
          <div class="fleet-card__label">
            <b>{{ block.settings.name }}</b>
            <span>{{ block.settings.type }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fahrzeuge",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Fahrzeuge" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Handschaltung oder Automat – du wählst" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Du lernst auf zwei modernen Fahrzeugen. Wähle beim Buchen einfach die passende Getriebeart." }
  ],
  "blocks": [
    {
      "type": "car",
      "name": "Fahrzeug",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild (freigestelltes PNG empfohlen)" },
        { "type": "text", "id": "name", "label": "Name", "default": "VW Golf" },
        { "type": "text", "id": "type", "label": "Getriebe / Zusatz", "default": "Handschaltung" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Fahrzeuge",
      "blocks": [
        { "type": "car", "settings": { "name": "VW Golf", "type": "Handschaltung" } },
        { "type": "car", "settings": { "name": "Hyundai i30", "type": "Automat" } }
      ]
    }
  ]
}
{% endschema %}
