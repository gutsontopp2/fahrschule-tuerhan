<section class="section">
  <div class="container confirmation">
    <span class="confirmation__check" aria-hidden="true">✓</span>
    <h1 style="font-size:clamp(1.7rem,5vw,2.4rem);">{{ section.settings.heading }}</h1>
    <p style="color:var(--asphalt);">{{ section.settings.text }}</p>

    <div class="confirmation__next">
      <h3>So geht es weiter</h3>
      <ol>
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ol>
    </div>

    <p style="margin-top:28px;">
      Fragen zu deinem Termin?
      {%- if settings.contact_phone != blank %} Ruf an unter <a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a>{% endif -%}
      {%- if settings.contact_whatsapp != blank %} oder <a href="https://wa.me/{{ settings.contact_whatsapp }}" target="_blank" rel="noopener">schreib per WhatsApp</a>{% endif -%}.
    </p>
    <a class="btn btn--ghost" href="{{ routes.root_url }}">Zurück zur Startseite</a>
  </div>
</section>

{% schema %}
{
  "name": "Buchungsbestätigung",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Danke – dein Termin ist gebucht!" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Du erhältst in wenigen Minuten eine Bestätigung per E-Mail mit Datum, Uhrzeit, Treffpunkt und allen Details. Bitte prüfe auch deinen Spam-Ordner." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Bestätigungs-E-Mail mit allen Termindetails prüfen." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Buchungsbestätigung",
      "blocks": [
        { "type": "step", "settings": { "text": "Bestätigungs-E-Mail mit Datum, Uhrzeit und Treffpunkt prüfen." } },
        { "type": "step", "settings": { "text": "24 Stunden vor dem Termin bekommst du eine Erinnerung." } },
        { "type": "step", "settings": { "text": "Lernfahrausweis mitnehmen und pünktlich am Treffpunkt sein – den Rest machen wir gemeinsam." } }
      ]
    }
  ]
}
{% endschema %}
