{%- liquid
  assign booking_url = '/pages/buchung'
  if settings.booking_page != blank
    assign booking_url = pages[settings.booking_page].url
  endif
  assign col = collections[section.settings.collection]
-%}
<section class="section section--white" id="angebot">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <hr class="roadline">
    </div>

    {%- if col == blank or col.products.size == 0 -%}
      {%- if request.design_mode -%}
        <p class="text-center" style="color:var(--asphalt);">Nur im Theme-Editor sichtbar: Lege im Shopify-Admin Produkte für die Fahrstunden an und wähle die Kollektion in den Abschnitts-Einstellungen aus.</p>
      {%- else -%}
        <p class="text-center" style="color:var(--asphalt);">Alle Angebote und Preise erhältst du gerne auf Anfrage – ruf mich an oder schreib mir per WhatsApp.</p>
      {%- endif -%}
    {%- else -%}
      <div class="packages">
        {%- for product in col.products limit: section.settings.limit -%}
          {% render 'product-card', product: product, booking_url: booking_url, featured_handle: section.settings.featured_product %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <p class="text-center" style="margin-top:32px;">
      <a class="btn btn--primary" href="{{ booking_url }}">Jetzt Termin wählen</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Fahrstunden & Pakete",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Angebot" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Fahrstunden & Pakete" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Abholung am vereinbarten Treffpunkt. Bezahlt wird sicher online über den Shopify-Checkout." },
    { "type": "collection", "id": "collection", "label": "Kollektion mit Fahrstunden" },
    { "type": "product", "id": "featured_product", "label": "Hervorgehobenes Produkt (Beliebt-Badge)" },
    { "type": "range", "id": "limit", "label": "Maximale Anzahl", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [ { "name": "Fahrstunden & Pakete" } ]
}
{% endschema %}
