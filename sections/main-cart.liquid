<section class="section">
  <div class="container" style="max-width:820px;">
    <div class="section-head">
      <h1 style="font-size:clamp(1.7rem,5vw,2.4rem);">Warenkorb</h1>
      <hr class="roadline">
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <p>Dein Warenkorb ist leer.</p>
        <a class="btn btn--primary" href="{% if settings.booking_page != blank %}{{ pages[settings.booking_page].url }}{% else %}/pages/buchung{% endif %}">Fahrstunde buchen</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-table">
          {%- for item in cart.items -%}
            <div class="cart-line">
              <div class="cart-line__head">
                <span class="cart-line__title">{{ item.product.title }}</span>
                <span class="cart-line__price">{{ item.final_line_price | money }}</span>
              </div>
              {%- if item.properties.size > 0 -%}
                <dl class="cart-line__props">
                  {%- for property in item.properties -%}
                    {%- assign first_char = property.first | slice: 0 -%}
                    {%- if property.last != blank and first_char != '_' -%}
                      <dt>{{ property.first }}</dt>
                      <dd>{{ property.last }}</dd>
                    {%- endif -%}
                  {%- endfor -%}
                </dl>
              {%- endif -%}
              <a class="cart-line__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Termin entfernen</a>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-footer">
          <div class="cart-footer__row">
            <span>Total</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="form-note">Dein Termin bleibt nur für die Dauer der Reservierung blockiert. Bitte schliesse die Zahlung zeitnah ab, sonst wird der Termin automatisch wieder freigegeben.</p>
          <button type="submit" name="checkout" class="btn btn--primary btn--block">Zur Kasse</button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Warenkorb",
  "settings": []
}
{% endschema %}
