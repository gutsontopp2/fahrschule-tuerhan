<section class="section section--dark" id="bewertungen">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <hr class="roadline">
    </div>
    <div class="testimonials">
      {%- for block in section.blocks -%}
        <figure class="testimonial" style="color:var(--nacht);" {{ block.shopify_attributes }}>
          <div class="testimonial__stars" aria-label="{{ block.settings.stars }} von 6 Sternen">
            {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
          </div>
          <blockquote>«{{ block.settings.quote }}»</blockquote>
          <figcaption>
            {{ block.settings.name }}
            <span>{{ block.settings.detail }}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bewertungen",
  "settings": [
    {
      "type": "paragraph",
      "content": "Wichtig: Nur echte, bestätigte Bewertungen veröffentlichen – keine erfundenen Namen oder Aussagen."
    },
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Bewertungen" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Das sagen meine Fahrschüler" },
    { "type": "text", "id": "text", "label": "Text", "default": "61 Fahrschüler haben mich bewertet – 99 % waren höchst zufrieden (6 von 6 Sternen)." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Bewertung",
      "settings": [
        { "type": "range", "id": "stars", "label": "Sterne (von 6)", "min": 1, "max": 6, "step": 1, "default": 6 },
        { "type": "textarea", "id": "quote", "label": "Zitat", "default": "Sehr kompetent, immer gut gelaunt! Habe die Fahrprüfung direkt im ersten Anlauf bestanden." },
        { "type": "text", "id": "name", "label": "Name", "default": "Fabio" },
        { "type": "text", "id": "detail", "label": "Zusatz", "default": "Kategorie B, bestanden im 1. Anlauf" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bewertungen",
      "blocks": [
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
