{%- liquid
  assign booking_url = '/pages/buchung'
  if settings.booking_page != blank
    assign booking_url = pages[settings.booking_page].url
  endif
-%}
<header class="site-header">
  <div class="container site-header__inner">
    <a href="{{ routes.root_url }}" class="site-logo">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 220 }}" alt="{{ shop.name | escape }}" width="110" height="40" loading="eager">
      {%- else -%}
        <span class="l-tile" aria-hidden="true">L</span>
        <span class="site-logo__text">Fahrschule Türhan<small>Mit mir zum Führerschein</small></span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {% render 'nav-links' %}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn--primary header-cta" href="{{ booking_url }}">Fahrstunde buchen</a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="Warenkorb">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-label="Menü öffnen" aria-controls="mobile-nav">
        {% render 'icon', name: 'menu' %}
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" data-mobile-nav aria-label="Mobile Navigation">
    <ul>
      {% render 'nav-links' %}
    </ul>
    <div class="mobile-nav__cta">
      <a class="btn btn--primary btn--block" href="{{ booking_url }}">Fahrstunde buchen</a>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Kopfzeile",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menü",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
