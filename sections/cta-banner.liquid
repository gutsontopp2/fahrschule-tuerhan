{%- liquid
  assign booking_url = '/pages/buchung'
  if settings.booking_page != blank
    assign booking_url = pages[settings.booking_page].url
  endif
-%}
<section class="section section--dark">
  <div class="container cta-banner">
    <h2>{{ section.settings.heading }}</h2>
    <p style="color:rgba(255,255,255,0.75);max-width:34em;margin:0 auto;">{{ section.settings.text }}</p>
    <a class="btn btn--primary" href="{{ booking_url }}">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "CTA-Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Bereit für deine erste Fahrstunde?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sichere dir jetzt online deinen Termin – freie Zeiten siehst du direkt im Kalender." },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Jetzt Termin buchen" }
  ],
  "presets": [ { "name": "CTA-Banner" } ]
}
{% endschema %}
