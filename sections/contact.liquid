<section class="section section--white" id="kontakt">
  <div class="container contact-grid">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p style="color:var(--asphalt);">{{ section.settings.text }}</p>

      <ul class="contact-list">
        {%- if settings.contact_phone != blank -%}
          <li>{% render 'icon', name: 'phone' %}<a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a></li>
        {%- endif -%}
        {%- if settings.contact_whatsapp != blank -%}
          <li>{% render 'icon', name: 'chat' %}<a href="https://wa.me/{{ settings.contact_whatsapp }}" target="_blank" rel="noopener">WhatsApp schreiben</a></li>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}
          <li>{% render 'icon', name: 'mail' %}<a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
        {%- endif -%}
        {%- if settings.contact_address != blank -%}
          <li>{% render 'icon', name: 'pin' %}<span style="white-space:pre-line;">{{ settings.contact_address }}</span></li>
        {%- endif -%}
      </ul>

      <h3>Öffnungszeiten</h3>
      <p class="opening-hours">{{ settings.opening_hours }}</p>
    </div>

    <div>
      {%- form 'contact', class: 'form-grid' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-success">Danke für deine Nachricht! Ich melde mich so schnell wie möglich bei dir.</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="form-errors">
            Bitte überprüfe deine Eingaben:
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="form-field">
          <label for="kontakt-name">Name</label>
          <input type="text" id="kontakt-name" name="contact[name]" autocomplete="name" required>
        </div>
        <div class="form-field">
          <label for="kontakt-email">E-Mail</label>
          <input type="email" id="kontakt-email" name="contact[email]" autocomplete="email" required>
        </div>
        <div class="form-field">
          <label for="kontakt-phone">Telefon (optional)</label>
          <input type="tel" id="kontakt-phone" name="contact[phone]" autocomplete="tel">
        </div>
        <div class="form-field">
          <label for="kontakt-body">Nachricht</label>
          <textarea id="kontakt-body" name="contact[body]" required></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Nachricht senden</button>
        <p class="form-note">Mit dem Absenden stimmst du der Verarbeitung deiner Angaben zur Beantwortung deiner Anfrage zu. Details in der Datenschutzerklärung.</p>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kontakt",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Kontakt" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Unverbindlich Kontakt aufnehmen" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Fragen zur Anmeldung, zum Ablauf oder zu den Preisen? Schreib mir – ich antworte in der Regel noch am selben Tag." }
  ],
  "presets": [ { "name": "Kontakt" } ]
}
{% endschema %}
