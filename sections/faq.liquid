<section class="section" id="faq">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <hr class="roadline">
    </div>
    <div class="faq-list">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="faq-item__body"><p>{{ block.settings.answer }}</p></div>
        </details>
      {%- endfor -%}
    </div>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Gut zu wissen" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Häufige Fragen" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Wie buche ich eine Fahrstunde?" },
        { "type": "textarea", "id": "answer", "label": "Antwort", "default": "Wähle online deine Fahrstundenart, einen freien Termin im Kalender und bezahle sicher über den Checkout. Du erhältst sofort eine Bestätigung per E-Mail." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq", "settings": { "question": "Wo werde ich abgeholt?", "answer": "Beim Buchen wählst du einen Treffpunkt aus – zum Beispiel Bahnhof Buchs SG oder nach Vereinbarung. Andere Treffpunkte sind auf Anfrage möglich." } },
        { "type": "faq", "settings": { "question": "Fahre ich handgeschaltet oder Automat?", "answer": "Beides ist möglich. Gib beim Buchen einfach die gewünschte Fahrstundenart an – gefahren wird im weissen Seat Leon FR." } },
        { "type": "faq", "settings": { "question": "Kann ich einen Termin verschieben oder stornieren?", "answer": "Ja, melde dich bitte spätestens 24 Stunden vorher telefonisch oder per WhatsApp. Kurzfristigere Absagen müssen verrechnet werden." } },
        { "type": "faq", "settings": { "question": "Was brauche ich für die erste Fahrstunde?", "answer": "Deinen gültigen Lernfahrausweis und bequeme Schuhe. Alles andere besprechen wir in der ersten Lektion." } }
      ]
    }
  ]
}
{% endschema %}
