# ============================================================
# Fahrschule Türhan – Buchungs-Backend
# Kopiere diese Datei nach .env und fülle alle Werte aus.
# Secrets NIEMALS ins Theme oder ins Git-Repository übernehmen.
# ============================================================

# Port des HTTP-Servers
PORT=3000

# PostgreSQL-Verbindung (z. B. Neon, Supabase, Railway, eigener Server)
DATABASE_URL=postgres://user:passwort@host:5432/fahrschule_buchung

# Shopify Custom App (Shopify-Admin → Einstellungen → Apps → App entwickeln)
# API-Secret der App: signiert App-Proxy-Anfragen und Webhooks
SHOPIFY_API_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxx
# myshopify-Domain des Shops
SHOPIFY_SHOP_DOMAIN=fahrschule-tuerhan.myshopify.com

# Eigenes App-Secret (min. 32 zufällige Zeichen) – signiert Buchungstokens
# und Admin-Sessions. Erzeugen z. B. mit: openssl rand -base64 48
APP_SECRET=bitte-durch-zufaelligen-wert-ersetzen-min-32-zeichen

# Admin-Passwort als scrypt-Hash. Erzeugen mit:
#   echo "MeinSicheresPasswort" | npm run migrate -- --hash-password
ADMIN_PASSWORD_HASH=

# Öffentliche Shop-URL für Links in E-Mails
PUBLIC_SHOP_URL=https://fahrschule-tuerhan.myshopify.com

# SMTP für Bestätigungs-/Betreiber-Mails (optional; ohne Angaben wird nur geloggt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Fahrschule Türhan <info@example.com>"
MAIL_OPERATOR=tuerhandilek@hotmail.com

# NUR Entwicklung: App-Proxy-Signaturprüfung deaktivieren (niemals in Produktion!)
# ALLOW_UNSIGNED_PROXY=1

NODE_ENV=production
